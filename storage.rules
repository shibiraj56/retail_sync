rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function belongsToOrg(orgId) {
      return isAuthenticated() && request.auth.token.orgId == orgId;
    }

    // Public catalog images
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Organization scoped assets & product images
    match /organizations/{orgId} {
      match /products/{productId}/{imageFile} {
        allow read: if belongsToOrg(orgId);
        // Only valid images under 5MB allowed
        allow write: if belongsToOrg(orgId) &&
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*');
      }

      match /{allPaths=**} {
        allow read: if belongsToOrg(orgId);
        allow write: if belongsToOrg(orgId);
      }
    }
  }
}
