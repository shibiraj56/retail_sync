rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Authoritative membership document lookup in Firestore
    function getMembershipDoc(orgId) {
      return get(/databases/$(database)/documents/userMemberships/$(request.auth.uid + '_' + orgId)).data;
    }

    // Validates that the caller holds an authoritative ACTIVE membership document in the organization
    // Stale JWT custom claims alone are NEVER trusted if the membership is missing or suspended
    function hasActiveMembership(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/userMemberships/$(request.auth.uid + '_' + orgId)) &&
        getMembershipDoc(orgId).status == 'ACTIVE';
    }

    function isOrgOwner(orgId) {
      return hasActiveMembership(orgId) && getMembershipDoc(orgId).role == 'OWNER';
    }

    function isOrgManager(orgId) {
      return hasActiveMembership(orgId) && (
        getMembershipDoc(orgId).role == 'OWNER' ||
        getMembershipDoc(orgId).role == 'MANAGER' ||
        getMembershipDoc(orgId).role == 'STORE_MANAGER'
      );
    }

    // Enforces store-level authorization against authoritative membership document
    function hasStoreAccess(orgId, storeId) {
      return hasActiveMembership(orgId) && (
        getMembershipDoc(orgId).role == 'OWNER' ||
        getMembershipDoc(orgId).assignedStoreIds == null ||
        getMembershipDoc(orgId).assignedStoreIds.size() == 0 ||
        storeId in getMembershipDoc(orgId).assignedStoreIds
      );
    }

    // Default Deny Rule for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. Global User Profiles & Authoritative Memberships ---
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Users can only create their own profile with standard initial fields
      allow create: if isUser(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'phoneNumber', 'isActive', 'defaultOrganizationId', 'createdAt', 'updatedAt']);

      // Users can ONLY update explicitly permitted non-administrative profile fields
      // Prevents self-escalation, changing role, modifying account status, or tampering with metadata
      allow update: if isUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'updatedAt']);

      allow delete: if false;
    }

    match /userMemberships/{membershipId} {
      // Members can read their own membership; active org members can read memberships in their org
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasActiveMembership(resource.data.organizationId)
      );

      // Memberships can ONLY be created or mutated by trusted Cloud Functions via Admin SDK
      // Direct client writes are strictly forbidden to prevent self-role escalation
      allow write: if false;
    }

    // --- 2. Organization Scope ---
    match /organizations/{orgId} {
      allow read: if hasActiveMembership(orgId);
      allow write: if isOrgOwner(orgId);

      // Store Directory & Scoped Subcollections
      match /stores/{storeId} {
        allow read: if hasActiveMembership(orgId);
        allow write: if isOrgOwner(orgId);

        // Store Inventory Balances (Direct client write FORBIDDEN)
        match /inventory/{variantId} {
          allow read: if hasStoreAccess(orgId, storeId);
          allow write: if false; // Mutated solely via Cloud Functions
        }

        // Store Sales & Invoices (Direct client write FORBIDDEN)
        match /sales/{saleId} {
          allow read: if hasStoreAccess(orgId, storeId);
          allow write: if false; // Created solely via processCheckout Cloud Function
        }

        // Sequential Counters (Direct client write FORBIDDEN)
        match /counters/{counterKey} {
          allow read: if hasStoreAccess(orgId, storeId);
          allow write: if false;
        }

        // Held Bills (Cashiers can park/resume carts directly for assigned branch)
        match /heldBills/{heldBillId} {
          allow read, write: if hasStoreAccess(orgId, storeId);
        }

        // Cash Drawer Sessions
        match /cashDrawers/{sessionId} {
          allow read: if hasStoreAccess(orgId, storeId);
          allow write: if false; // Settled solely via Cloud Functions
        }
      }

      // Master Catalog
      match /products/{productId} {
        allow read: if hasActiveMembership(orgId);
        allow write: if isOrgManager(orgId);

        match /variants/{variantId} {
          allow read: if hasActiveMembership(orgId);
          allow write: if isOrgManager(orgId);
        }
      }

      // Stock Movement Audit Ledger (Strictly Append-Only via Admin SDK)
      match /stockMovements/{movementId} {
        allow read: if hasActiveMembership(orgId);
        allow write: if false;
      }

      // Idempotency Keys (Internal system collection)
      match /idempotencyKeys/{keyId} {
        allow read, write: if false;
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow read: if isOrgOwner(orgId);
        allow write: if false;
      }
    }
  }
}
