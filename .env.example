# Environment Mode
VITE_APP_ENV=development

# Firebase Project Configuration (In local emulator mode, demo-* projects work without API keys)
VITE_FIREBASE_API_KEY=AIzaSyDemoDummyApiKeyForEmulators
VITE_FIREBASE_AUTH_DOMAIN=demo-retail-sync.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-retail-sync
VITE_FIREBASE_STORAGE_BUCKET=demo-retail-sync.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase Emulator Hosts
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=http://127.0.0.1:5001
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# App Check Debug Token (Optional for development)
VITE_APP_CHECK_DEBUG_TOKEN=
